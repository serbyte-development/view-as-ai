{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/**/*", "scripts/**/*", "package.json", "tsconfig.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["src/fixtures/**/*"],
      "linter": {
        "rules": {
          "a11y": {
            "noInteractiveElementToNoninteractiveRole": "off",
            "noRedundantAlt": "off",
            "noRedundantRoles": "off",
            "noSvgWithoutTitle": "off",
            "useAltText": "off",
            "useAnchorContent": "off",
            "useIframeTitle": "off",
            "useMediaCaption": "off",
            "useSemanticElements": "off",
            "useValidAnchor": "off"
          },
          "security": {
            "noScriptUrl": "off"
          }
        }
      }
    }
  ]
}
