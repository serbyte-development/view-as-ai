{
  "name": "@serbyte/view-as-ai-calibration-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx src/build.tsx",
    "capture:compare": "cd ../.. && uv run python packages/calibration-site/scripts/calibration-capture.py compare",
    "capture:finalize": "cd ../.. && uv run python packages/calibration-site/scripts/calibration-capture.py finalize",
    "check": "tsx scripts/check-calibration-results.ts && biome check . && tsc --noEmit",
    "check:results": "tsx scripts/check-calibration-results.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
